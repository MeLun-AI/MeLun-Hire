# =================================================
# MeLun Hire — Frontend environment template (Vite)
# Copy this file to `.env.local` (development) or configure the same variables
# in the Vercel project settings (production/preview). `.env*` files are
# git-ignored — never commit real values.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle, so
# never put secrets here.
# =================================================

# Base URL of the deployed backend API (Render). Also accepted: VITE_API_BASE_URL.
VITE_API_URL=<your-api-base-url>

# Public base URL of the frontend itself, used to build links shared with
# applicants (e.g. interview access links). Leave unset to use the browser
# origin automatically.
VITE_APP_URL=<your-frontend-origin>
