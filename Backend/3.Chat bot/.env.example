# =================================================
# MeLun Hire — Backend environment template
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — NEVER commit real secrets.
# Placeholders only: replace every <...> value below.
# =================================================

# ---- App / deployment ----
APP_ENV=<development|production>          # "production" enables secure cookies and hard-fails on a missing SECRET_KEY
APP_DEBUG=<true|false>
FRONTEND_URL=<your-frontend-origin>
ALLOWED_ORIGINS=<origin-1>,<origin-2>     # comma separated; "*" is rejected by design

# ---- Database ----
# SQLite only for now — the data layer uses the sqlite3 driver directly.
# Forms: sqlite:///database/database.db | sqlite:////var/data/database.db
DATABASE_URL=<sqlite-connection-string>

# ---- File storage ----
# Root directory for uploaded resumes and profile images. Point this at a mounted
# persistent volume in production (e.g. /var/data); defaults to <backend>/data.
STORAGE_DIR=<storage-root-directory>

# ---- Security / sessions ----
SECRET_KEY=<generate-a-strong-secret>
TOKEN_EXPIRY_HOURS=<hours>
TOKEN_LENGTH=<bytes>
SESSION_COOKIE_NAME=<cookie-name>
SESSION_TTL_HOURS=<hours>
SESSION_COOKIE_SECURE=<true|false>
SESSION_COOKIE_SAMESITE=<lax|strict|none>

# ---- LLM / AI ----
OPENAI_API_KEY=<your-openai-api-key>
LLM_MODEL=<model-name>
LLM_TEMPERATURE=<0.0-1.0>
LLM_MAX_TOKENS=<tokens>

# ---- Interview ----
INTERVIEW_ROUNDS=<count>
INTERVIEW_QUESTIONS_PER_ROUND=<count>
INTERVIEW_TIME_LIMIT=<seconds>
INTERVIEW_BASE_URL=<interview-base-url>

# ---- Group discussion & scoring ----
GD_DURATION=<seconds>
GD_MIN_PARTICIPANTS=<count>
RESUME_WEIGHT=<0.0-1.0>
TECHNICAL_WEIGHT=<0.0-1.0>
BEHAVIORAL_WEIGHT=<0.0-1.0>
GD_WEIGHT=<0.0-1.0>
RESUME_PASS_THRESHOLD=<score>
FINAL_PASS_THRESHOLD=<score>

# ---- Reports / output ----
OUTPUT_FORMAT=<json>
SAVE_REPORTS=<true|false>
REPORTS_DIR=<output-directory>

# ---- Email (SMTP) ----
SMTP_SERVER=<smtp-host>
SMTP_PORT=<port>
SMTP_USERNAME=<your-email>
SMTP_PASSWORD=<your-app-password>
SMTP_FROM=<your-email>
SENDER_EMAIL=<your-email>
SENDER_PASSWORD=<your-app-password>
